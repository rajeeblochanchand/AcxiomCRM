<div class="page-toolbar">
  <div class="tabs">
    <a class="<%= tab === 'all' ? 'active' : '' %>" href="/followups">All</a>
    <a class="<%= tab === 'upcoming' ? 'active' : '' %>" href="/followups?tab=upcoming">Upcoming</a>
    <a class="<%= tab === 'overdue' ? 'active' : '' %>" href="/followups?tab=overdue">Overdue</a>
    <a class="<%= tab === 'completed' ? 'active' : '' %>" href="/followups?tab=completed">Completed</a>
  </div>
  <a class="btn btn-primary" href="/followups/new">Schedule follow-up</a>
</div>
<article class="card">
  <table>
    <thead><tr><th>Date</th><th>Type</th><th>Related</th><th>Status</th><th>Owner</th><th></th></tr></thead>
    <tbody>
      <% if (!followUps.length) { %><tr><td colspan="6" class="muted">No follow-ups.</td></tr><% } %>
      <% followUps.forEach(f => { %>
        <tr>
          <td><%= formatDate(f.FollowUpDate) %></td>
          <td><%= f.FollowUpType %></td>
          <td><%= f.CustomerName || f.LeadName || '—' %></td>
          <td><span class="<%= pillClass(f.DisplayStatus) %>"><%= f.DisplayStatus %></span></td>
          <td><%= f.OwnerName || '—' %></td>
          <td class="row-actions">
            <% if (f.Status === 'Planned') { %>
              <button class="linkish" type="button" data-open-modal="complete-<%= f.FollowUpId %>">Complete</button>
              <button class="linkish" type="button" data-open-modal="reschedule-<%= f.FollowUpId %>">Reschedule</button>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</article>

<% followUps.forEach(f => { %>
  <% if (f.Status === 'Planned') { %>
    <div class="modal" id="complete-<%= f.FollowUpId %>" hidden>
      <div class="modal-card">
        <h3>Complete follow-up</h3>
        <form method="post" action="/followups/<%= f.FollowUpId %>/complete">
          <label>Remarks
            <textarea name="Remarks" rows="3"><%= f.Remarks || '' %></textarea>
          </label>
          <div class="form-actions">
            <button class="btn btn-ghost" type="button" data-close-modal>Cancel</button>
            <button class="btn btn-primary" type="submit">Mark completed</button>
          </div>
        </form>
      </div>
    </div>
    <div class="modal" id="reschedule-<%= f.FollowUpId %>" hidden>
      <div class="modal-card">
        <h3>Reschedule follow-up</h3>
        <form method="post" action="/followups/<%= f.FollowUpId %>/reschedule" data-validate="followup-reschedule">
          <label>New date
            <input type="date" name="FollowUpDate" required />
            <span class="field-error" data-error-for="FollowUpDate"></span>
          </label>
          <label>Remarks
            <textarea name="Remarks" rows="3"><%= f.Remarks || '' %></textarea>
          </label>
          <div class="form-actions">
            <button class="btn btn-ghost" type="button" data-close-modal>Cancel</button>
            <button class="btn btn-primary" type="submit">Reschedule</button>
          </div>
        </form>
      </div>
    </div>
  <% } %>
<% }) %>
