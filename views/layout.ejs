<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · AcxiomCRM</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
  <aside class="sidebar">
    <div class="brand">
      <span class="brand-mark">A</span>
      <div>
        <strong>AcxiomCRM</strong>
        <p>Sales workspace</p>
      </div>
    </div>
    <nav>
      <a class="<%= isActive('/dashboard') ? 'active' : '' %>" href="/dashboard">
        <svg viewBox="0 0 24 24"><path d="M4 13h6V4H4v9zm0 7h6v-5H4v5zm10 0h6V11h-6v9zm0-17v5h6V4h-6z"/></svg>
        Dashboard
      </a>
      <a class="<%= isActive('/customers') ? 'active' : '' %>" href="/customers">
        <svg viewBox="0 0 24 24"><path d="M12 12c2.7 0 5-2.3 5-5s-2.3-5-5-5-5 2.3-5 5 2.3 5 5 5zm0 2c-3.3 0-10 1.7-10 5v3h20v-3c0-3.3-6.7-5-10-5z"/></svg>
        Customers
      </a>
      <a class="<%= isActive('/leads') ? 'active' : '' %>" href="/leads">
        <svg viewBox="0 0 24 24"><path d="M12 2 4 7v10l8 5 8-5V7l-8-5zm0 2.2 5.2 3.2L12 11 6.8 7.4 12 4.2zM6 9.3l5 3.1v6.3L6 15.6V9.3zm7 9.4v-6.3l5-3.1v6.3l-5 3.1z"/></svg>
        Leads
      </a>
      <a class="<%= isActive('/opportunities') ? 'active' : '' %>" href="/opportunities">
        <svg viewBox="0 0 24 24"><path d="M3 17.2 9.2 11l4 4L21 7.2 19.6 5.8 13.2 12.2l-4-4L1.6 15.8 3 17.2zM3 20h18v2H3z"/></svg>
        Opportunities
      </a>
      <a class="<%= isActive('/followups') ? 'active' : '' %>" href="/followups">
        <svg viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z"/></svg>
        Follow-ups
      </a>
      <a class="<%= isActive('/activities') ? 'active' : '' %>" href="/activities">
        <svg viewBox="0 0 24 24"><path d="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h10v2H4v-2z"/></svg>
        Activities
      </a>
      <a class="<%= isActive('/reports') ? 'active' : '' %>" href="/reports">
        <svg viewBox="0 0 24 24"><path d="M5 9h3v11H5V9zm6-6h3v17h-3V3zm6 9h3v8h-3v-8z"/></svg>
        Reports
      </a>
      <% if (currentUser && currentUser.roleName === 'Admin') { %>
        <a class="<%= isActive('/users') ? 'active' : '' %>" href="/users">
          <svg viewBox="0 0 24 24"><path d="M16 11c1.7 0 3-1.3 3-3s-1.3-3-3-3-3 1.3-3 3 1.3 3 3 3zM8 11c1.7 0 3-1.3 3-3S9.7 5 8 5 5 6.3 5 8s1.3 3 3 3zm0 2c-2.7 0-8 1.3-8 4v3h10v-3c0-1.1.4-2.1 1.1-3C10.1 13.4 9.1 13 8 13zm8 0c-.3 0-.7 0-1 .1 1.8.8 3 2.2 3 3.9v3h6v-3c0-2.7-5.3-4-8-4z"/></svg>
          Users
        </a>
        <a class="<%= isActive('/audit') ? 'active' : '' %>" href="/audit">
          <svg viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm1 15H9v-2h6v2zm0-4H9v-2h6v2zm-1-5V3.5L18.5 8H14z"/></svg>
          Audit logs
        </a>
      <% } %>
    </nav>
  </aside>
  <div class="shell">
    <header class="topbar">
      <div>
        <p class="eyebrow">AcxiomCRM</p>
        <h1><%= title %></h1>
      </div>
      <% if (currentUser) { %>
        <div class="topbar-user">
          <div>
            <strong><%= currentUser.name %></strong>
            <span class="pill pill-slate"><%= currentUser.roleName %></span>
          </div>
          <form action="/logout" method="post">
            <button class="btn btn-ghost" type="submit">Sign out</button>
          </form>
        </div>
      <% } %>
    </header>
    <% if (flash) { %>
      <div class="alert alert-<%= flash.type === 'success' ? 'success' : 'error' %>"><%= flash.message %></div>
    <% } %>
    <main class="content">
      <%- include(view) %>
    </main>
  </div>
  <script src="/js/validation.js"></script>
</body>
</html>
