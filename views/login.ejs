<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign in · AcxiomCRM</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="auth-body">
  <div class="auth-card">
    <div class="brand auth-brand">
      <span class="brand-mark">A</span>
      <div>
        <strong>AcxiomCRM</strong>
        <p>Sign in to your workspace</p>
      </div>
    </div>
    <% if (message) { %><div class="alert alert-error"><%= message %></div><% } %>
    <form action="/login" method="post" data-validate="auth">
      <label>Email
        <input type="email" name="Email" value="<%= values.Email || '' %>" required />
        <span class="field-error" data-error-for="Email"><%= errors.Email || '' %></span>
      </label>
      <label>Password
        <input type="password" name="Password" required />
        <span class="field-error" data-error-for="Password"><%= errors.Password || '' %></span>
      </label>
      <button class="btn btn-primary btn-block" type="submit">Sign in</button>
    </form>
    <p class="muted">Need an account? <a href="/register">Register</a></p>
    <p class="hint">Demo: admin@crm.com · manager@crm.com · sales@crm.com / Password@123</p>
  </div>
  <script src="/js/validation.js"></script>
</body>
</html>
